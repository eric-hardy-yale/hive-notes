# Copy to .env (in this folder or the folder above it) and fill in. Never commit .env.
# Course key: gpt-6-luna through Portkey.
PORTKEY_API_KEY=
# Optional fallback if you have no Portkey key (uses OpenAI directly, same model name).
OPENAI_API_KEY=

# Optional server settings (defaults shown)
# DAILY_BUDGET_USD=1.00        # hard daily cap on AI spend; calls stop when it's reached
# RATE_PER_HOUR=60             # AI calls per device per hour
# APP_ACCESS_CODE=             # if set, the app must send this code (used on the public server)
# PORT=8040
